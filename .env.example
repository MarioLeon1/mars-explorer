# Copy to .env (scripts/setup.ps1 does it for you). Every value is optional; defaults work.
# Never commit .env — it is gitignored.

# Where the database and downloaded images live (default: <repo>/data)
# MARS_DATA_DIR=C:\path\to\mars-data

# DEBUG | INFO | WARNING
MARS_LOG_LEVEL=INFO

# Politeness towards NASA servers (seconds between requests)
MARS_REQUEST_DELAY_S=0.5
MARS_DOWNLOAD_DELAY_S=0.15

# Optional AI assistant (Assistant page). Leave empty to keep it off; the rest of the app
# works without it. Create a key at https://platform.claude.com (billed per token, separately
# from a Claude.ai subscription), paste it after the = and restart the backend. Keep it secret.
ANTHROPIC_API_KEY=
# Model: claude-opus-5-5 (default, $4/$20 per M tokens) | claude-sonnet-5-5 | claude-haiku-5-5 ($0.10/$0.50)
# MARS_ASSISTANT_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
# MARS_ASSISTANT_EFFORT=medium
